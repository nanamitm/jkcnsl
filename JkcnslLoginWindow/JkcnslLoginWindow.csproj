<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>JkcnslLoginWindow</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>JkcnslLoginWindow.ico</ApplicationIcon>
    <Authors>xtne6f</Authors>
    <!-- ThemeMode (Windowsのライト/ダーク設定への追従) は試験的APIとして警告されるため抑制する -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="JkcnslLoginWindow.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

</Project>
